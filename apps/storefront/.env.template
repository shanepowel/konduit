# Publishable API key for the Medusa backend (from admin or seed log)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=zw
# Public site origin for Open Graph / canonical URLs (production: https://www.konduit.co.zw)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Optional n8n → Twenty CRM webhook for the quote wizard.
# Falls back to Medusa /store/quote-requests when unset.
NEXT_PUBLIC_QUOTE_WEBHOOK_URL=

# Contact + quote inbox notifications (Resend preferred).
# Domain must be verified in Resend for RESEND_FROM_EMAIL to deliver.
# Quote requests also send a confirmation to the address entered when RESEND_API_KEY is set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Konduit <hello@konduit.co.zw>
CONTACT_TO_EMAIL=hello@konduit.co.zw
# Optional fallback if Resend is unset (n8n / Zapier / Formspree-style webhook).
CONTACT_WEBHOOK_URL=

# Meilisearch search-only key (never the admin/master key)
NEXT_PUBLIC_MEILISEARCH_HOST=
NEXT_PUBLIC_MEILISEARCH_API_KEY=

NODE_ENV=development
