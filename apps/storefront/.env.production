# Production build defaults for Vercel.
# NEXT_PUBLIC_* values are inlined at build time — must be present during `next build`.
# Publishable keys are designed to be public (browser-exposed). Override in the
# Vercel project dashboard when pointing at a different Medusa backend.

NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_43db3a8b8bc52fa2b7f68bc282422422e7afce1252ee492199e85b5636cd6879
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://konduit.medusajs.app
NEXT_PUBLIC_DEFAULT_REGION=zw
NEXT_PUBLIC_BASE_URL=https://konduit.medusajs.site
