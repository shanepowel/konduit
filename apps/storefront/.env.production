# Production defaults for Vercel / local production builds.
# Offline-first: catalogue, quotes and contact run without Medusa Cloud cost.
# Set NEXT_PUBLIC_COMMERCE_MODE=live and a working backend URL to re-enable Cloud.

NEXT_PUBLIC_COMMERCE_MODE=offline
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_offline_konduit
NEXT_PUBLIC_DEFAULT_REGION=zw
# Public site origin used for Open Graph / canonical URLs (must match the live domain).
NEXT_PUBLIC_BASE_URL=https://www.konduit.co.zw
